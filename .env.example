# Telegram botingiz tokeni (@BotFather orqali olingan)
BOT_TOKEN=

# Dars jadvali yuboriladigan guruh ID raqami (masalan: -1001234567890)
# Guruhda /id buyrug'ini yuborib bilib olishingiz mumkin.
GROUP_ID=

# Bot administratorlarining Telegram ID raqamlari (vergul bilan ajratilgan)
# Bu adminlar botga Excel fayl yuborib jadvalni yangilashlari mumkin.
# Shaxsiy chatda botga /id yuborib o'z ID ingizni bilib olasiz.
ADMIN_IDS=

# Jadval har kuni soat nechada guruhga yuborilsin (Format: HH:MM, masalan 07:30)
SEND_TIME=07:30

# Vaqt mintaqasi
TIMEZONE=Asia/Tashkent

# Dam olish / dars yo'q kunlarda ham "Bugun dars yo'q" deb xabar yuborilsinmi? (true yoki false)
NOTIFY_ON_OFF_DAYS=false
